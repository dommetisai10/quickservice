# Server Environment Settings
ENVIRONMENT=production
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/quickservice_prod?retryWrites=true&w=majority
DB_NAME=quickservice_prod
JWT_SECRET=your_64_character_generated_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=https://your-frontend.vercel.app

# Initial System Admin User Credentials
ADMIN_EMAIL=admin@quickservice.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME=System Admin
ADMIN_PHONE=9876543210
